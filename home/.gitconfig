[user]
	name = Sito8943
	email = sito8943@gmail.com
	username = Sito8943

[core]
	excludesfile = ~/.global-gitignore
	autocrlf = false
	pager = delta

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[fetch]
	prune = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

# GitHub auth through gh (no plaintext tokens in ~/.git-credentials)
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

# Machine-only overrides (signing key, work email per folder, ...)
[include]
	path = ~/.dotfiles-custom/.gitconfig

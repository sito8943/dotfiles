# PHP / Laravel
alias phpunit="vendor/bin/phpunit"
alias a="php artisan"
alias pa="php artisan"
alias mfs='php artisan migrate:fresh --seed'
alias pp="./vendor/bin/pest --parallel"
alias cu="composer update"
alias cr="composer require"
alias ci="composer install"
alias cda="composer dump-autoload -o"

# Claude Code / Codex
alias c="claude"
alias cy="claude-yolo"
alias cxy="codex --dangerously-bypass-approvals-and-sandbox"
# Second account (config in ~/.claude1)
alias claude1='CLAUDE_CONFIG_DIR="$HOME/.claude1" command claude'

# JavaScript
alias jest="./node_modules/.bin/jest"

# Git
alias gpo="git push origin"
alias push="git push"
alias pull="git pull"
alias uncommit="git reset --soft HEAD~1"
alias nah='git reset --hard;git clean -df'

# Files & editors
alias o='open "$PWD"'
alias l="ls -laF"
alias vscode='code "$PWD"'
alias hostfile="sudo vi /etc/hosts"
alias sshconfig="vi ~/.ssh/config"
alias copykey='{ command cat ~/.ssh/id_ed25519.pub 2>/dev/null || command cat ~/.ssh/sito8943.pub; } | pbcopy'

# Redis
alias flush-redis="redis-cli FLUSHALL"

# Show/hide hidden files in Finder
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# IP addresses
alias ip="curl ifconfig.me/ip ; echo"
alias localip="ipconfig getifaddr en0"

# Flush DNS cache
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Games
alias simutrans='cd "$HOME/Library/Application Support/Steam/steamapps/common/Simutrans" && ./simutrans.app/Contents/MacOS/simutrans'

# Modern CLI tools (only when installed). grep is NOT aliased to rg on purpose:
# scripts and copy-pasted commands expect real grep flags.
if command -v eza &> /dev/null; then
    alias ls="eza --icons --group-directories-first"
    alias l="eza -la --icons --group-directories-first --hyperlink"
    alias ll="eza -l --icons --group-directories-first --hyperlink"
    alias lt="eza --tree --level=2 --icons"
fi

if command -v bat &> /dev/null; then
    alias cat="bat --style=plain --paging=never"
fi

if command -v btm &> /dev/null; then
    alias htop="btm"
fi

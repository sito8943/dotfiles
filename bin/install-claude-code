#!/bin/bash
#
# Claude Code setup. Safe to re-run; can run on its own or from bin/install.
#
# What it manages (symlinks, originals backed up first):
#   ~/.claude/CLAUDE.md               ← config/claude/AGENTS.md (global instructions)
#   ~/.claude/personal.settings.json  ← config/claude/personal.settings.json
#   ~/.claude/statusline-command.sh   ← config/claude/statusline-command.sh
#
# What it never touches:
#   ~/.claude/settings.json  apps (Claude Code, Sito Editor, plugins) rewrite it in
#                            place, and it holds machine/work paths; keep it local.
#   ~/.claude/skills, ~/.claude/agents  your installed skills stay as they are.
#                            Repo skills are linked one by one only if you say yes.
#
# Env: DRY_RUN=1 prints actions only; ASSUME_YES=1 skips questions.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$DOTFILES/config/claude"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY_RUN="${DRY_RUN:-0}"
ASSUME_YES="${ASSUME_YES:-0}"

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
step()    { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}⚠${NC} $1"; }

run() { if [ "$DRY_RUN" = 1 ]; then echo "  [dry-run] $*"; else "$@"; fi; }

ask() {
    [ "$ASSUME_YES" = 1 ] && return 0
    local reply
    read -r -p "$1 (y/n) " -n 1 reply
    echo ""
    [[ $reply =~ ^[Yy]$ ]]
}

link() {
    local source="$1" target="$2"
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        echo "  = ${target/#$HOME/\~}"
        return
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        local rel="${target#$HOME/}"
        run mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
        run mv "$target" "$BACKUP_DIR/$rel"
        echo "  ↺ backed up ${target/#$HOME/\~}"
    fi
    run mkdir -p "$(dirname "$target")"
    run ln -s "$source" "$target"
    echo "  → ${target/#$HOME/\~}"
}

# ── CLI ──────────────────────────────────────────────────────────────────────
step "Claude Code CLI"
if command -v claude &>/dev/null || [ -x "$HOME/.local/bin/claude" ]; then
    success "Already installed"
else
    run bash -c 'curl -fsSL https://claude.ai/install.sh | bash' || warn "Install failed"
fi

# ── Config files ─────────────────────────────────────────────────────────────
step "Claude config files"
link "$SRC/AGENTS.md"               "$HOME/.claude/CLAUDE.md"
link "$SRC/personal.settings.json"  "$HOME/.claude/personal.settings.json"
link "$SRC/statusline-command.sh"   "$HOME/.claude/statusline-command.sh"
success "Config linked (settings.json left untouched)"

# ── Optional: repo skills/agents, one link each, never replacing yours ───────
step "Repo skills & agents"
if ask "Link skills/agents from config/claude that you don't already have?"; then
    for kind in skills agents; do
        [ -d "$SRC/$kind" ] || continue
        run mkdir -p "$HOME/.claude/$kind"
        for item in "$SRC/$kind"/*; do
            name="$(basename "$item")"
            target="$HOME/.claude/$kind/$name"
            if [ -e "$target" ] || [ -L "$target" ]; then
                continue
            fi
            run ln -s "$item" "$target"
            echo "  + $kind/$name"
        done
    done
    success "Missing skills/agents linked"
else
    warn "Skipped"
fi

echo ""
[ -d "$BACKUP_DIR" ] && echo "  Backups: ${BACKUP_DIR/#$HOME/~}"
success "Claude Code setup complete"

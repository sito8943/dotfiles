#!/bin/bash
#
# Install dotfiles on this Mac.
#
#   bin/install            interactive: asks before every section
#   bin/install --dry-run  print what would happen, change nothing
#   bin/install --yes      answer "yes" to every section
#
# Anything replaced is first moved to ~/.dotfiles-backup/<timestamp>/.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY_RUN=0
ASSUME_YES=0

for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY_RUN=1 ;;
        --yes|-y)     ASSUME_YES=1 ;;
        -h|--help)    sed -n 3,9p "$0"; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
step()    { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}⚠${NC} $1"; }

# Run a command, or only print it in dry-run mode.
run() {
    if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] $*"
    else
        "$@"
    fi
}

ask() {
    [ "$ASSUME_YES" = 1 ] && return 0
    local reply
    read -r -p "$1 (y/n) " -n 1 reply
    echo ""
    [[ $reply =~ ^[Yy]$ ]]
}

# link SOURCE TARGET — back up TARGET (file, dir or foreign symlink) and symlink it to SOURCE.
pretty() { case "$1" in "$HOME"*) echo "~${1#"$HOME"}" ;; *) echo "$1" ;; esac; }

link() {
    local source="$1" target="$2"
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        echo "  = $(pretty "$target")"
        return
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        local rel="${target#$HOME/}"
        run mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
        run mv "$target" "$BACKUP_DIR/$rel"
        echo "  ↺ backed up $(pretty "$target")"
    fi
    run mkdir -p "$(dirname "$target")"
    run ln -s "$source" "$target"
    echo "  → $(pretty "$target")"
}

echo ""
echo "Dotfiles: $DOTFILES"
[ "$DRY_RUN" = 1 ] && warn "Dry run: nothing will be changed"

# ── ~/.dotfiles symlink ──────────────────────────────────────────────────────
# Every config refers to ~/.dotfiles, so it must point at this checkout.
if [ "$DOTFILES" != "$HOME/.dotfiles" ]; then
    step "Linking ~/.dotfiles → $DOTFILES"
    link "$DOTFILES" "$HOME/.dotfiles"
fi

# ── Homebrew ─────────────────────────────────────────────────────────────────
if ! command -v brew &>/dev/null; then
    step "Homebrew"
    if ask "Homebrew is missing. Install it?"; then
        run /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        [ "$DRY_RUN" = 0 ] && eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

if command -v brew &>/dev/null; then
    step "Brewfile packages"
    if ask "Install missing packages from config/Brewfile?"; then
        run brew bundle --file="$DOTFILES/config/Brewfile" || warn "Some entries failed (often apps already installed outside Homebrew)"
    fi
fi

# ── Oh My Zsh + plugins ──────────────────────────────────────────────────────
step "Oh My Zsh"
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    if ask "Install Oh My Zsh?"; then
        run sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
    fi
fi
OMZ_PLUGINS="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [ -d "$HOME/.oh-my-zsh" ] && [ ! -d "$OMZ_PLUGINS/$plugin" ]; then
        run git clone --depth 1 "https://github.com/zsh-users/$plugin" "$OMZ_PLUGINS/$plugin"
    fi
done
success "Oh My Zsh ready"

# ── Shell, git, editor, terminal configs ─────────────────────────────────────
step "Shell & git config"
if ask "Symlink .zshrc, .gitconfig, .global-gitignore?"; then
    link "$DOTFILES/home/.zshrc"            "$HOME/.zshrc"
    link "$DOTFILES/home/.gitconfig"        "$HOME/.gitconfig"
    link "$DOTFILES/home/.global-gitignore" "$HOME/.global-gitignore"
    run touch "$HOME/.hushlogin"
    run mkdir -p "$HOME/.dotfiles-custom/shell"
    success "Shell & git linked"
fi

step "Terminal config (Ghostty, tmux)"
if ask "Symlink ~/.config/ghostty/config and ~/.tmux.conf?"; then
    link "$DOTFILES/config/ghostty/config" "$HOME/.config/ghostty/config"
    link "$DOTFILES/config/tmux.conf"      "$HOME/.tmux.conf"
    success "Terminal config linked"
fi

# ── Node via nvm ─────────────────────────────────────────────────────────────
step "Node (nvm)"
if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
    if ask "nvm is missing. Install it with the LTS Node?"; then
        run bash -c 'curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | PROFILE=/dev/null bash'
        run bash -c '. "$HOME/.nvm/nvm.sh" && nvm install --lts && nvm alias default lts/*'
    fi
else
    success "nvm already installed"
fi

# ── Spotlight exclusions ─────────────────────────────────────────────────────
step "Spotlight exclusions"
if ask "Keep heavy dev folders out of Spotlight?"; then
    run bash "$DOTFILES/bin/exclude-from-spotlight" || warn "Spotlight exclusions had issues"
fi

# ── macOS defaults ───────────────────────────────────────────────────────────
step "macOS defaults"
if [ "$DRY_RUN" = 1 ]; then
    echo "  [dry-run] would offer macos/set-defaults.sh (asks again before running)"
elif ask "Apply macOS defaults (Finder, Dock, keyboard…)? Review macos/set-defaults.sh first"; then
    bash "$DOTFILES/macos/set-defaults.sh"
fi

# ── Claude Code ──────────────────────────────────────────────────────────────
step "Claude Code"
if ask "Set up Claude Code config?"; then
    DRY_RUN=$DRY_RUN ASSUME_YES=$ASSUME_YES bash "$DOTFILES/bin/install-claude-code"
fi

echo ""
success "Done."
[ -d "$BACKUP_DIR" ] && echo "  Backups: $(pretty "$BACKUP_DIR")"
echo "  Machine-only settings: ~/.dotfiles-custom/shell/.zshrc and ~/.dotfiles-custom/.gitconfig"
echo "  Reload: exec zsh"
echo ""

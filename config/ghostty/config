# Ghostty — config para nvim / dev

# Fuente con iconos (nvim-tree, devicons)
font-family = JetBrainsMono Nerd Font
font-size = 14

# CLAVE: Option = Alt -> hace funcionar Alt+flechas, Alt+a, etc. en nvim
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Ventana
window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# Scrollback
# En bytes, no líneas (~10 MB)
scrollback-limit = 10000000

# Tema oscuro (cambia con: ghostty +list-themes)
theme = "Catppuccin Mocha"

# Cmd+/ -> abre la lista de hotkeys en nvim (manda Esc + comando).
keybind = super+slash=text:\x1b:Telescope keymaps\r

# --- Agentes (Claude Code, etc.) ---
# Bell del agente -> notificación macOS + Dock + título + borde
bell-features = system,attention,title,border

# SSH: copia terminfo xterm-ghostty al remoto (evita TERM roto en servidores)
shell-integration-features = ssh-env,ssh-terminfo

# Aviso si un comando largo termina con la ventana sin foco
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s

# Terminal desplegable global (requiere permiso de Accesibilidad)
keybind = global:ctrl+alt+space=toggle_quick_terminal

# Renombrar pestaña (Cmd+Shift+R)
keybind = super+shift+r=prompt_tab_title

# Ghostty — config para nvim / dev

# Fuente con iconos (nvim-tree, devicons)
font-family = JetBrainsMono Nerd Font
font-size = 14

# CLAVE: Option = Alt -> hace funcionar Alt+flechas, Alt+a, etc. en nvim
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Ventana
window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# Scrollback
# En bytes, no líneas (~10 MB)
scrollback-limit = 10000000

# Tema oscuro (cambia con: ghostty +list-themes)
theme = "Catppuccin Mocha"

# Cmd+/ -> abre la lista de hotkeys en nvim (manda Esc + comando).
keybind = super+slash=text:\x1b:Telescope keymaps\r
